{
  "name": "zustand-tui",
  "version": "0.1.0",
  "description": "Terminal User Interface (TUI) for inspecting Zustand state in real-time",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "zustand-tui": "dist/cli.js",
    "zustand-mcp": "dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "GLOSSARY.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.tsx",
    "demo": "node demo-dispatch.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:bin": "bun build --compile --minify ./src/cli.tsx --outfile ./bin/zustand-tui && bun build --compile --minify ./src/mcp-cli.ts --outfile ./bin/zustand-mcp",
    "install:bin": "bun run build:bin && mkdir -p ~/.local/bin && cp ./bin/zustand-tui ~/.local/bin/zustand-tui && cp ./bin/zustand-mcp ~/.local/bin/zustand-mcp"
  },
  "keywords": [
    "zustand",
    "tui",
    "cli",
    "devtools",
    "terminal"
  ],
  "author": "Lincon Kusunoki <linconkusunoki@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linconkusunoki/zustand-tui.git"
  },
  "bugs": {
    "url": "https://github.com/linconkusunoki/zustand-tui/issues"
  },
  "homepage": "https://github.com/linconkusunoki/zustand-tui#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/ws": "^8.5.14",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^4.28.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
